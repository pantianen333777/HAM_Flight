<launch>
  <arg name="config" default="$(find vision_gripper)/config/vision_gripper.yaml"/>
  <arg name="start_realsense" default="true"/>
  <arg name="start_mavros" default="false"/>
  <arg name="fcu_url" default="/dev/ttyACM0:57600"/>
  <arg name="dry_run" default="true"/>

  <include if="$(arg start_realsense)" file="$(find realsense2_camera)/launch/rs_camera.launch">
    <arg name="align_depth" value="true"/>
    <arg name="enable_sync" value="true"/>
    <arg name="enable_gyro" value="false"/>
    <arg name="enable_accel" value="false"/>
  </include>

  <include if="$(arg start_mavros)" file="$(find mavros)/launch/px4.launch">
    <arg name="fcu_url" value="$(arg fcu_url)"/>
  </include>

  <node pkg="vision_gripper" type="vision_gripper_node.py"
        name="vision_gripper" output="screen" required="true">
    <rosparam command="load" file="$(arg config)"/>
    <param name="dry_run" value="$(arg dry_run)"/>
  </node>
</launch>
