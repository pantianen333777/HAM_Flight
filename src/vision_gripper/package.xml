<?xml version="1.0"?>
<package format="2">
  <name>vision_gripper</name>
  <version>0.1.0</version>
  <description>D435i color/depth target detection and guarded PX4 gripper control.</description>
  <maintainer email="noreply@example.invalid">HAM Flight</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>apriltag_ros</depend>
  <depend>cv_bridge</depend>
  <depend>gazebo_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>message_filters</depend>
  <depend>nav_msgs</depend>
  <depend>nodelet</depend>
  <depend>quadrotor_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>

  <exec_depend>realsense2_camera</exec_depend>
</package>
